{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inventarios",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-06-01",
  // Resumen diario de alertas por correo (06:00 UTC).
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventarios",
      "database_id": "a647a69b-3e66-4fa6-b40a-8250b640c7e2"
    }
  ]
}
